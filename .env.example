# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=gestionctp27

# Puerto HTTP de la API
PORT=4000

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:3000
# Lista separada por comas para permitir varios orígenes exactos
# CORS_ORIGINS=http://localhost:3000,https://gestionctp27.vercel.app

# URL pública del frontend (enlaces en correos; si falta, se usa CORS_ORIGIN)
FRONTEND_URL=http://localhost:3000

# Opción A: cadena de conexión completa a PostgreSQL
# (los caracteres especiales de la contraseña, como %, van URL-encoded)
# DATABASE_URL=postgres://usuario:contraseña@localhost:5432/gestionctp27

# Conexión con SSL (true para bases remotas como Supabase)
DB_SSL=true

# Autenticación (JWT en cookie httpOnly)
JWT_SECRET=
JWT_EXPIRACION=1h
# Local: false + lax. Producción cross-site (Vercel/Railway): true + none
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Correo transaccional (Brevo API v3)
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=CTP 27 de Abril
